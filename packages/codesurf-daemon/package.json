{
  "name": "@codesurf/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeSurf local HTTP daemon (codesurfd) and process supervisor. Used by both the desktop app and the codesurf TUI.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./manager": {
      "types": "./dist/manager.d.ts",
      "import": "./dist/manager.js",
      "default": "./dist/manager.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "import": "./dist/sse.js",
      "default": "./dist/sse.js"
    },
    "./chat-cli": {
      "types": "./dist/chat-cli.d.ts",
      "import": "./dist/chat-cli.js",
      "default": "./dist/chat-cli.js"
    },
    "./chat-session-store": {
      "types": "./dist/chat-session-store.d.ts",
      "import": "./dist/chat-session-store.js",
      "default": "./dist/chat-session-store.js"
    },
    "./chat-policy": {
      "types": "./dist/chat-policy.d.ts",
      "import": "./dist/chat-policy.js",
      "default": "./dist/chat-policy.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js",
      "default": "./dist/paths.js"
    },
    "./bin/codesurfd": "./bin/codesurfd.mjs",
    "./bin/chat-jobs": "./bin/chat-jobs.mjs",
    "./bin/checkpoints": "./bin/checkpoints.mjs",
    "./bin/memory-loader": "./bin/memory-loader.mjs",
    "./bin/skills-index": "./bin/skills-index.mjs",
    "./bin/file-references": "./bin/file-references.mjs",
    "./bin/session-index": "./bin/session-index.mjs",
    "./bin/context-buckets": "./bin/context-buckets.mjs",
    "./bin/project-context": "./bin/project-context.mjs",
    "./bin/instruction-context": "./bin/instruction-context.mjs"
  },
  "bin": {
    "codesurfd": "./bin/codesurfd.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "vendor/",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:dist": "node scripts/verify-dist.mjs",
    "prepack": "npm run verify:dist",
    "test:unit": "node --test test/*.test.mjs",
    "test": "npm run typecheck && npm run verify:dist && npm run test:unit"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.49",
    "@ai-sdk/harness-claude-code": "1.0.50",
    "@ai-sdk/harness-codex": "1.0.51",
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "@openai/codex-sdk": "0.139.0",
    "better-sqlite3": "12.8.0"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
